<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Huvo_Backend_Context.md Sections 3.4, 7, 10, 11: the shared audit-log writer. Audit is
    NOT a service and NOT a queue consumer - every service appends to the one shared
    huvo_audit_log DynamoDB table through this library, in-process.

    Deliberately NOT a Spring Boot app and NOT a Spring dependency. Each consuming service
    supplies its own @Configuration that builds the client, so this module stays a plain
    jar: huvo-audit-client, huvo-security-lib and huvo-event-contracts all install the same
    way and can be consumed by a non-Spring (or future) service without dragging a context
    along. The only runtime dependency is the AWS SDK v2 DynamoDB client - deliberately NOT
    the Spring Data DynamoDB starter, which would make a web context mandatory.
  -->
  <groupId>com.huvo</groupId>
  <artifactId>huvo-audit-client</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>huvo-audit-client</name>
  <description>Huvo shared audit-log writer for the huvo_audit_log table - Sections 3.4 and 7</description>
  <packaging>jar</packaging>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <aws.sdk.version>2.31.11</aws.sdk.version>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <spotless.version>3.10.3</spotless.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Stubs the DynamoDbClient so the unit tests need no DynamoDB Local (Section 8.2). -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.14.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Same formatter as every service (Section 10) - keep the version + config in
        sync with the copies in each service pom (Section 11).
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.28.0</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports />
            <importOrder>
              <order>java,javax,org,com</order>
            </importOrder>
            <trimTrailingWhitespace />
            <endWithNewline />
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
