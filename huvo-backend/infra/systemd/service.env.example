# Template for /etc/huvo/<service>.env - the systemd EnvironmentFile each service reads
# (Huvo_Backend_Context.md Sections 4.3 and 9).
#
# On EC2 this file is GENERATED at instance boot by the CloudFormation UserData script,
# pulling values from SSM Parameter Store (SecureString). It is never committed, and it
# is never hand-edited on the box. Locally, use a gitignored application-local.yml
# instead (Section 8.1) - this file is only for the systemd path.

SERVER_PORT=8081
DB_HOST=localhost
DB_PORT=3306
DB_NAME=huvo_identity
DB_USERNAME=huvo
DB_PASSWORD=<from SSM: /huvo/<env>/db/password>
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=huvo
RABBITMQ_PASSWORD=<from SSM: /huvo/<env>/rabbitmq/password>
JWT_SIGNING_KEY=<from SSM: /huvo/<env>/jwt/signing-key>
AWS_REGION=ap-south-1

# Note: JVM sizing (-Xms/-Xmx) belongs in the systemd unit's ExecStart, not in this file
# (Section 8.3).

