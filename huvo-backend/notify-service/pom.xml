<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.5</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <!--
    Huvo_Backend_Context.md Sections 3.1, 3.2, 7, 12: notify-service consumes events from every other
    service, builds the in-app notification feed, and is the single WebSocket hub the frontend
    multiplexes everything real-time through (Huvo_Frontend_Context.md Section 5.3).

    Independently buildable: not a module of a shared reactor (Section 11).
  -->
  <groupId>com.huvo</groupId>
  <artifactId>notify-service</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>notify-service</name>
  <description>Huvo notify service - in-app notification feed and the single WebSocket hub</description>

  <properties>
    <java.version>17</java.version>
    <spotless.version>3.10.3</spotless.version>
    <!-- The Spring Boot BOM manages the DynamoDB client, but pinned anyway to match the SDK
      generation the other services already resolve, so the two cannot drift apart. -->
    <aws.sdk.version>2.31.11</aws.sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!--
      The security lib is what makes the WebSocket handshake authenticated: a browser cannot send an
      Authorization header on a WebSocket upgrade, so the token arrives as a query parameter and is
      validated in-process with the same code that validates REST calls. See WebSocketConfig.
    -->
    <dependency>
      <groupId>com.huvo</groupId>
      <artifactId>huvo-security-lib</artifactId>
      <version>0.0.1-SNAPSHOT</version>
    </dependency>

    <!--
      huvo-event-contracts is load-bearing here, not decorative. Every listener binds its message to
      EventEnvelope<T> with T a shared payload record, so a producer/consumer mismatch fails at
      deserialization with a Jackson error naming the field, instead of silently yielding nulls that
      look like data. See EnvelopeParser.
    -->
    <dependency>
      <groupId>com.huvo</groupId>
      <artifactId>huvo-event-contracts</artifactId>
      <version>0.0.1-SNAPSHOT</version>
    </dependency>

    <!-- Notifications live in DynamoDB (Section 3.2): simple write-heavy access, no joins. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Tests must run on any agent, without MySQL, RabbitMQ, DynamoDB or S3 (Section 9).
      There is no Testcontainers and no DynamoDB Local: Section 8.1 rules out Docker, so the
      DynamoDB-backed feed is behind the NotificationStore port and the in-memory implementation
      is what the suite runs against.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbit-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Section 0: deployable JAR name is huvo-<servicename> -> huvo-notify-service.jar -->
    <finalName>huvo-notify-service</finalName>
    <plugins>
      <!-- Section 10: one formatter for every service. Keep the version + config in sync. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.28.0</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports />
            <importOrder>
              <order>java,javax,org,com</order>
            </importOrder>
            <trimTrailingWhitespace />
            <endWithNewline />
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
