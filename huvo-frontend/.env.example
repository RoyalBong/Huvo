# Copy to .env.local / .env.<mode> — every value is environment-driven
# (Huvo_Frontend_Context.md §5.2, §11). No literal URL ever lives in source.

# Nginx-fronted backend base URL (Backend EC2).
VITE_API_BASE_URL=http://localhost:8080

# Optional per-service overrides for local dev without nginx
# (Huvo_Backend_Context.md §8.1). Omit in production builds.
VITE_API_IDENTITY_URL=http://localhost:8081
VITE_API_ATTENDANCE_URL=http://localhost:8082
VITE_API_WORKLIFE_URL=http://localhost:8083
VITE_API_PAYROLL_URL=http://localhost:8084
VITE_API_NOTIFY_URL=http://localhost:8085

# The single WebSocket endpoint — notify-service (§5.3).
VITE_WS_URL=ws://localhost:8085/api/notify/ws
