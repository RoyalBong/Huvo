# Local development env (npm run dev) — backend running natively per
# Huvo_Backend_Context.md §8.1 (no Docker, no containers anywhere).
#
# Base URL used when no per-service override is set (e.g. local nginx for
# full routing parity with production).
VITE_API_BASE_URL=http://localhost:8080

# Per-service overrides — call each service directly (§8.1: "Nginx isn't
# required for day-to-day local dev"). Ports from §3.2.
VITE_API_IDENTITY_URL=http://localhost:8081
VITE_API_ATTENDANCE_URL=http://localhost:8082
VITE_API_WORKLIFE_URL=http://localhost:8083
VITE_API_PAYROLL_URL=http://localhost:8084
VITE_API_NOTIFY_URL=http://localhost:8085

# Single WebSocket connection to notify-service (§5.3).
VITE_WS_URL=ws://localhost:8085/api/notify/ws
