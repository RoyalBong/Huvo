# Production build env — copy to .env.ec2-prod (gitignored) and fill in the
# Backend EC2 address, then run: npm run build:prod
# Vars are baked in at build time (§11) — one build per environment.
VITE_API_BASE_URL=http://<BACKEND_EC2_PUBLIC_DNS>
VITE_WS_URL=ws://<BACKEND_EC2_PUBLIC_DNS>/api/notify/ws
