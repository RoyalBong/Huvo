// Huvo backend CI/CD - no Docker anywhere in the build or the deploy path
// (Huvo_Backend_Context.md Sections 9 and 11).
//
// Per service: checkout -> unit test -> package JAR -> upload to S3 as
// s3://huvo-<env>-artifacts/<service>/<gitSha>.jar -> AWS SSM Run Command swaps
// /opt/huvo/<service>.jar on the backend EC2 and restarts huvo-<service>.service.
//
// Required Jenkins configuration:
//   - credential `huvo-backend-instance-id` (Secret text) - the backend EC2 instance id
//     (or the CloudFormation stack output once that stack exists: Section 12, Phase 6).
//   - AWS credentials on the agent (instance role / credential binding) allowing
//     s3:PutObject on the artifacts bucket and ssm:SendCommand on the backend instance.
// TODO(phase-1): this service list changes when employee-service + department-service
// are folded into identity-service (Section 3.1).

def services = ['employee-service', 'department-service']

def runOnBackend(String comment, String commandsJson) {
    sh """
        set -e
        COMMAND_ID=\$(aws ssm send-command \\
            --document-name "AWS-RunShellScript" \\
            --targets "Key=instanceids,Values=${env.BACKEND_INSTANCE_ID}" \\
            --comment "${comment}" \\
            --parameters 'commands=${commandsJson}' \\
            --query 'Command.CommandId' --output text)
        aws ssm wait command-executed --command-id "\$COMMAND_ID" --instance-id "${env.BACKEND_INSTANCE_ID}"
    """
}

pipeline {
    agent {
        // The build runner only. No service in this repo ships a Dockerfile, and
        // nothing is deployed as a container (Section 9).
        docker {
            image 'shayandutta98/jenkins-agent:latest'
        }
    }

    environment {
        AWS_DEFAULT_REGION  = 'ap-south-1'
        HUVO_ENV            = 'prod'
        ARTIFACT_BUCKET     = "huvo-${HUVO_ENV}-artifacts"
        BACKEND_INSTANCE_ID = credentials('huvo-backend-instance-id')
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Unit Test') {
            steps {
                script {
                    def tasks = [:]
                    services.each { service ->
                        tasks[service] = {
                            dir("Huvo-backend/${service}") {
                                sh 'mvn -B test'
                                junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                            }
                        }
                    }
                    parallel tasks
                }
            }
        }

        stage('Build JAR') {
            steps {
                script {
                    def tasks = [:]
                    services.each { service ->
                        tasks[service] = {
                            dir("Huvo-backend/${service}") {
                                sh 'mvn -B clean package -DskipTests'
                                archiveArtifacts artifacts: 'target/*.jar', allowEmptyArchive: false
                            }
                        }
                    }
                    parallel tasks
                }
            }
        }

        stage('Upload JAR to S3') {
            steps {
                script {
                    def gitSha = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    // Versioned key, never a single latest.jar, so rollback is
                    // re-running the SSM command against the previous key (Section 9).
                    def tasks = [:]
                    services.each { service ->
                        tasks[service] = {
                            dir("Huvo-backend/${service}") {
                                sh "aws s3 cp target/*.jar s3://${env.ARTIFACT_BUCKET}/${service}/${gitSha}.jar --no-progress"
                            }
                        }
                    }
                    parallel tasks
                }
            }
        }

        stage('Deploy to EC2 (SSM Run Command)') {
            when {
                branch 'main'
            }
            steps {
                script {
                    def gitSha = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    services.each { service ->
                        runOnBackend("huvo ${service} ${gitSha}", "[\"aws s3 cp s3://${env.ARTIFACT_BUCKET}/${service}/${gitSha}.jar /opt/huvo/${service}.jar\",\"chown huvo:huvo /opt/huvo/${service}.jar\",\"systemctl restart huvo-${service}.service\",\"systemctl is-active huvo-${service}.service\"]")
                    }
                }
            }
        }

        stage('Deploy Nginx Config') {
            when {
                branch 'main'
            }
            steps {
                script {
                    def gitSha = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    sh "aws s3 cp Huvo-backend/nginx/huvo-backend.conf s3://${env.ARTIFACT_BUCKET}/nginx/huvo-backend.conf --no-progress"
                    runOnBackend("huvo nginx config ${gitSha}", "[\"aws s3 cp s3://${env.ARTIFACT_BUCKET}/nginx/huvo-backend.conf /etc/nginx/sites-available/huvo\",\"ln -sf /etc/nginx/sites-available/huvo /etc/nginx/sites-enabled/huvo\",\"nginx -t\",\"systemctl reload nginx\"]")
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check logs.'
        }
    }
}
