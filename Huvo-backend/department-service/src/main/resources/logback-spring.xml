<configuration>
    <!--
      Container-friendly logging (Huvo Backend_Context.md §8.1): stdout only.
      Docker captures stdout and the CloudWatch agent ships it off the instance.
      Never log to a file inside the container - those disappear on recreation.
      TODO(phase-7): switch the encoder to logstash-logback-encoder for JSON output
      once the dependency is added to the build.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
